# Google Sheets Published URL Key
NEXT_PUBLIC_SHEETS_ID=YOUR_SHEETS_PUBLISHED_ID_HERE

# WhatsApp Number (with country code, no +)
NEXT_PUBLIC_WA_NUMBER=6285212312312

# Admin Panel Password
ADMIN_PASSWORD=your_strong_password_here

# Bitly Access Token (optional - get from dev.bitly.com)
BITLY_ACCESS_TOKEN=

# JWT Secret for admin sessions (use a long random string)
JWT_SECRET=your_very_long_random_secret_here_min_32_chars
